{
  "name": "webcap",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chrome extension for reliable viewport, full-page, region, element, and scroll-area capture.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-content-script.mjs && node scripts/verify-extension-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "node scripts/format-test-diagnostic.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "benchmark:pdf": "vitest run --config vitest.benchmark.config.ts --reporter=verbose",
    "test:smoke": "node tests/smoke/extension-smoke.mjs",
    "test:release": "node tests/release/packaged-lifecycle.mjs --report artifacts/packaged-lifecycle-playwright.json",
    "package": "pnpm build && node scripts/package-extension.mjs && node scripts/verify-release-package.mjs",
    "package:verify": "pnpm build && node scripts/verify-reproducible-package.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "audit:privacy": "node scripts/audit-privacy.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "audit:security": "pnpm audit --audit-level=critical",
    "audit": "pnpm audit:privacy && pnpm audit:dependencies && pnpm audit:release",
    "release:verify": "pnpm audit:security && pnpm package:verify && pnpm test:release"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
